# Local development uses http://localhost:8000 by default. For Vercel, set this
# to the HTTPS URL of your separately hosted FastAPI backend.
VITE_API_URL=
# Required Firebase Web App configuration for sign-in and account-scoped cloud data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
