AI_PROVIDER=gemini
GEMINI_API_KEY=add-your-server-side-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
# For local Ollama development, set AI_PROVIDER=ollama and uncomment:
# OLLAMA_HOST=http://localhost:11434
# CHAT_MODEL=qwen2.5:3b
# VISION_MODEL=llava:7b
CORS_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Keep the Firebase Admin service account JSON on the backend only. Never add it to frontend/.env.
FIREBASE_SERVICE_ACCOUNT_JSON=
